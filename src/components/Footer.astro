---
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <img src="/assets/logo-light.webp" alt="Aqar One" width="117" height="40" />
        <p class="body-sm about">
          A Saudi real estate group operating in Jeddah since 2011 — rated Class "A" by the
          Real Estate General Authority and accredited as a judicial sale agent by the Ministry of Justice.
        </p>
      </div>
      <div>
        <div class="eyebrow col-title">Offices</div>
        {SITE.offices.map((o) => <p class="body-sm about">{o}</p>)}
      </div>
      <div>
        <div class="eyebrow col-title">Contact</div>
        <div class="contact">
          <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          <a href={`mailto:${SITE.hrEmail}`}>{SITE.hrEmail}</a>
          <a href={SITE.mainSite} target="_blank" rel="noopener noreferrer">aqar1.com ↗</a>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} Aqar One. All rights reserved.</span>
      <span class="code">careers.aqar1.com</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--espresso); padding-block: var(--space-8) var(--space-6); }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: var(--space-7); padding-bottom: var(--space-7); border-bottom: 1px solid var(--espresso-soft); }
  img { display: block; height: 40px; width: auto; margin-bottom: var(--space-4); }
  .about { color: var(--ink-on-dark-2); margin: 0 0 var(--space-3); max-width: 44ch; }
  .col-title { color: var(--ink-3); margin-bottom: var(--space-4); }
  .contact { display: flex; flex-direction: column; gap: var(--space-3); }
  .contact a, .site-footer a { color: var(--ink-on-dark-2); font-size: 0.9375rem; }
  .contact a:hover { color: var(--ink-on-dark); }
  .bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-6); flex-wrap: wrap; }
  .bottom span { font-size: 0.8125rem; color: var(--ink-3); }
  @media (max-width: 767px) { .cols { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
