---
import type { HeroBlock as HeroBlockData } from '../../cms/types';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  data: HeroBlockData;
}

const { data } = Astro.props;
---
<section class="section hero grid-backdrop">
  <Container class="hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">{data.eyebrow}</div>
      <h1 class="display">{data.title}</h1>
      <p class="body-lg muted">{data.description}</p>
      <div class="hero-ctas">
        <Button href={data.primaryCta.href} variant="primary">{data.primaryCta.label}</Button>
        <Button href={data.secondaryCta.href} variant="secondary">{data.secondaryCta.label}</Button>
      </div>
    </div>
    <div class="seal" aria-label={data.seal.label}>
      <div class="seal-a">{data.seal.class}</div>
      <div class="seal-text">{data.seal.label}</div>
    </div>
  </Container>
  <Container>
    <dl class="stats">
      {data.stats.map((s) => (
        <div>
          <dt>{s.value}</dt>
          <dd>{s.label}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>

<style>
  .hero { border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1fr auto; gap: var(--space-7); align-items: center; }
  .hero-copy { max-width: 720px; display: flex; flex-direction: column; gap: var(--space-5); }
  .hero-copy .body-lg { margin: 0; max-width: 60ch; }
  .hero-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .seal {
    width: 132px; height: 132px; border-radius: 50%;
    background: var(--bronze-tint); border: 1px solid var(--bronze-ring);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-1); text-align: center; box-shadow: var(--shadow-1);
  }
  .seal-a { font-family: var(--font-display); font-size: 2rem; font-weight: 600; color: var(--bronze-deep); line-height: 1; }
  .seal-text { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bronze-deep); line-height: 1.4; max-width: 96px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); border-top: 1px solid var(--line-strong); padding-top: var(--space-6); margin: var(--space-8) 0 0; }
  .stats dt { font-family: var(--font-display); font-size: 2.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .stats dd { margin: var(--space-1) 0 0; font-size: 0.9375rem; color: var(--ink-2); }

  @media (max-width: 767px) {
    .hero-grid { grid-template-columns: 1fr; }
    .seal { width: 96px; height: 96px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
