---
import { SITE } from '../config';
---
<div class="utility-bar">
  <div class="container inner">
    <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
    <div class="links">
      <a href={`mailto:${SITE.hrEmail}`}>{SITE.hrEmail}</a>
      <a href={SITE.mainSite}>aqar1.com ↗</a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand">
      <img src="/assets/logo-dark.png" alt="Aqar One" height="36" />
      <span class="eyebrow brand-tag">Careers</span>
    </a>
    <nav>
      <a href="/#why" class="nav-link">Why Aqar One</a>
      <a href="/#roles" class="nav-link">Open Roles</a>
      <a href="/#process" class="nav-link">Hiring Process</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <a href="/#roles" class="btn btn-primary btn-sm">View Open Roles</a>
    </nav>
  </div>
</header>

<style>
  .utility-bar { height: 40px; background: var(--espresso); display: flex; align-items: center; }
  .utility-bar .inner { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .utility-bar a { color: var(--ink-on-dark-2); font-size: 0.8125rem; font-weight: 500; }
  .utility-bar a:hover { color: var(--ink-on-dark); }
  .utility-bar .links { display: flex; gap: var(--space-5); }

  .site-header {
    position: sticky; top: 0; z-index: 50; height: 72px;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
    display: flex; align-items: center;
  }
  .site-header .inner { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .brand { display: flex; align-items: center; gap: var(--space-3); }
  .brand img { display: block; height: 36px; width: auto; }
  .brand-tag { color: var(--ink-3); border-inline-start: 1px solid var(--line-strong); padding-inline-start: var(--space-3); }
  nav { display: flex; align-items: center; gap: 28px; }
  .nav-link { font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); padding-block: 6px; border-bottom: 2px solid transparent; }
  .nav-link:hover { color: var(--ink); border-bottom-color: var(--bronze); }
  @media (max-width: 767px) { .nav-link { display: none; } }
</style>
