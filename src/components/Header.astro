---
import type { SiteSettings } from '../cms/types';
import { getSiteSettings } from '../cms/repository';

interface Props {
  site?: SiteSettings;
}

const { site: siteProp } = Astro.props;
const site = siteProp || (await getSiteSettings());
---
<div class="utility-bar">
  <div class="container utility-inner">
    <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    <div class="utility-links">
      <a class="utility-email" href={`mailto:${site.hrEmail}`}>{site.hrEmail}</a>
      <a href={site.mainSite} target="_blank" rel="noopener noreferrer">aqar1.com ↗</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.careersName} home`}>
      <img src="/assets/logo-dark.png" alt={site.name} width="145" height="50" />
      <span class="eyebrow brand-tag">Careers</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/#why" class="nav-link">Why Aqar One</a>
      <a href="/#roles" class="nav-link">Open Roles</a>
      <a href="/#process" class="nav-link">Hiring Process</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <a href="/#roles" class="btn btn-primary btn-sm">View Open Roles</a>
    </nav>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Open navigation menu">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        <a href="/#why">Why Aqar One</a>
        <a href="/#roles">Open Roles</a>
        <a href="/#process">Hiring Process</a>
        <a href="/#faq">FAQ</a>
        <a href="/#roles" class="btn btn-primary">View Open Roles</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileNav = document.querySelector('[data-mobile-nav]');
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileNav.removeAttribute('open'));
  });
</script>

<style>
  .utility-bar { min-height: 40px; background: var(--espresso); display: flex; align-items: center; }
  .utility-inner { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .utility-bar a { color: var(--ink-on-dark-2); font-size: 0.8125rem; font-weight: 500; }
  .utility-bar a:hover { color: var(--ink-on-dark); }
  .utility-links { display: flex; gap: var(--space-5); }

  .site-header {
    position: sticky; inset-block-start: 0; z-index: 50; min-height: 72px;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    display: flex; align-items: center;
  }
  .header-inner { position: relative; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .brand { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
  .brand img { inline-size: 145px; block-size: auto; }
  .brand-tag { color: var(--ink-3); border-inline-start: 1px solid var(--line-strong); padding-inline-start: var(--space-3); }

  .desktop-nav { display: flex; align-items: center; gap: 28px; }
  .nav-link { font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); padding-block: 6px; border-bottom: 2px solid transparent; }
  .nav-link:hover { color: var(--ink); border-bottom-color: var(--bronze); }

  .mobile-nav { display: none; }
  .mobile-nav summary { list-style: none; inline-size: 44px; block-size: 44px; border: 1px solid var(--line-strong); border-radius: var(--radius-btn); background: var(--surface); cursor: pointer; align-items: center; justify-content: center; flex-direction: column; gap: 5px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary span { inline-size: 19px; block-size: 2px; background: var(--ink); border-radius: 2px; transition: transform 150ms ease, opacity 150ms ease; }
  .mobile-nav[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-nav[open] summary span:nth-child(2) { opacity: 0; }
  .mobile-nav[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-nav nav {
    position: absolute; inset-inline: 20px; inset-block-start: calc(100% + 12px);
    display: flex; flex-direction: column; gap: var(--space-2);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
    box-shadow: var(--shadow-3); padding: var(--space-4);
  }
  .mobile-nav nav > a:not(.btn) { min-height: 44px; display: flex; align-items: center; padding-inline: var(--space-3); color: var(--ink); font-weight: 600; border-radius: var(--radius-btn); }
  .mobile-nav nav > a:not(.btn):hover { background: var(--bronze-tint); }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
    .mobile-nav summary { display: flex; }
  }

  @media (max-width: 520px) {
    .utility-email, .brand-tag { display: none; }
    .brand img { inline-size: 124px; }
  }
</style>
