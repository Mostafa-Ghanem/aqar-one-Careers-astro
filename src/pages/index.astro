---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBlock from '../components/blocks/HeroBlock.astro';
import ValuesBlock from '../components/blocks/ValuesBlock.astro';
import JobsBlock from '../components/blocks/JobsBlock.astro';
import ProcessBlock from '../components/blocks/ProcessBlock.astro';
import FAQBlock from '../components/blocks/FAQBlock.astro';
import CTABlock from '../components/blocks/CTABlock.astro';
import { getSiteSettings, getHomePageContent, getOpenJobs } from '../cms/repository';

const site = await getSiteSettings();
const home = await getHomePageContent();
const jobs = await getOpenJobs();
---
<BaseLayout
  title={site.defaultSeo.title}
  description={site.defaultSeo.description}
  site={site}
>
  <HeroBlock data={home.hero} />
  <ValuesBlock data={home.values} />
  <JobsBlock data={home.jobs} jobs={jobs} hrEmail={site.hrEmail} />
  <ProcessBlock data={home.process} />
  <FAQBlock data={home.faq} />
  <CTABlock data={home.cta} hrEmail={site.hrEmail} />
</BaseLayout>
